# --- Telegram Bot ---
BOT_TOKEN=
ADMIN_ID=

# --- SMTP 邮件服务 (可选) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- 区块链 API ---
TRONGRID_API_KEY=
BSCSCAN_API_KEY=

# --- OCR 配置 (地址截图核验) ---
# Tesseract 路径 (Windows 自动探测，Linux 通常无需设置)
TESSERACT_CMD=

# --- 大模型翻译配置 ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-3.5-turbo
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_LLM=gemini

# --- 日志配置 ---
# 分类目录：$LOG_DIR/app, $LOG_DIR/tunnel, $LOG_DIR/runtime
LOG_DIR=/home/ubuntu/tgbot/logs
LOG_RETENTION_HOURS=48
