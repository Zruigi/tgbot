# --- Telegram Bot ---
BOT_TOKEN=
ADMIN_ID=

# --- SMTP 邮件服务 (可选) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- 区块链 API ---
TRONGRID_API_KEY=
BSCSCAN_API_KEY=

# --- OCR 配置 (地址截图核验) ---
# Tesseract 路径 (Windows 自动探测，Linux 通常无需设置)
TESSERACT_CMD=

# --- 大模型翻译配置 ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-3.5-turbo
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_LLM=gemini

# --- Agent virtual contact / advertisement actions ---
AI_ASSISTANT_USER_ID=-99999
LEGACY_AI_ASSISTANT_USER_IDS=900000001
AD_DELETE_ENABLED=false
AD_KICK_ENABLED=false

# --- 日志配置 ---
# 分类目录：$LOG_DIR/app, $LOG_DIR/tunnel, $LOG_DIR/runtime
LOG_DIR=/home/ubuntu/tgbot/logs
LOG_RETENTION_HOURS=48

# --- Development-only switches ---
# Keep disabled in production/tunnel deployments.
ALLOW_LOCAL_API_BYPASS=0

# --- Rust SaaS backend / Supabase ---
SAAS_BIND_ADDR=127.0.0.1:8090
SAAS_BACKEND_URL=
SAAS_PROXY_TIMEOUT=20
SUPABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_SAAS_SECRET=
SYNC_MERCHANTS_TO_SUPABASE_ON_START=0
